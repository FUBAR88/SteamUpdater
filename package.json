{
  "name": "steam-updater",
  "version": "1.0.0",
  "description": "Manage DayZ mods and upload them to the Steam Workshop as the owner or a contributor.",
  "main": "src/main.js",
  "author": "Fubar",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "prestart": "dotnet build steam-helper/SteamHelper.csproj -c Release",
    "start": "electron .",
    "dist": "dotnet build steam-helper/SteamHelper.csproj -c Release && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "local.steamupdater.app",
    "productName": "Steam Updater",
    "directories": {
      "output": "Release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "steam-helper/bin/Release/net48",
        "to": "steam-helper",
        "filter": [
          "*.exe",
          "*.dll",
          "*.config",
          "*.txt"
        ]
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Steam Updater.exe"
    }
  }
}
