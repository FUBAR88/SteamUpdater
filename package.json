{
  "name": "steam-updater",
  "version": "1.0.1",
  "description": "Manage DayZ mods and upload them to the Steam Workshop as the owner or a contributor.",
  "main": "src/main.js",
  "author": "Fubar",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "prestart": "dotnet build steam-helper/SteamHelper.csproj -c Release",
    "start": "electron .",
    "helper": "dotnet build steam-helper/SteamHelper.csproj -c Release",
    "dist": "npm run helper && electron-builder --win nsis nsis-web portable --publish never",
    "dist:setup": "npm run helper && electron-builder --win nsis --publish never",
    "release": "npm run helper && electron-builder --win nsis nsis-web portable --publish always"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "local.steamupdater.app",
    "productName": "Steam Updater",
    "directories": {
      "output": "Release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "steam-helper/bin/Release/net48",
        "to": "steam-helper",
        "filter": [
          "*.exe",
          "*.dll",
          "*.config",
          "*.txt"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "nsis-web",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Steam Updater",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "license": "LICENSE",
      "artifactName": "Steam Updater Setup ${version}.exe",
      "differentialPackage": false
    },
    "nsisWeb": {
      "artifactName": "Steam Updater Web Setup ${version}.exe"
    },
    "portable": {
      "artifactName": "Steam Updater.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "FUBAR88",
        "repo": "SteamUpdater",
        "releaseType": "release"
      }
    ]
  }
}
